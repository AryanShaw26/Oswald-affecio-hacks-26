# Backend environment — NEVER commit this file
# Copy to backend/.env and fill in your real values

# Neon PostgreSQL connection string
# Use postgresql+psycopg2:// prefix for psycopg2 driver
# Neon dashboard provides: postgresql://user:pass@host/dbname?sslmode=require
# Change the scheme to: postgresql+psycopg2://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<database>?sslmode=require

# Generate a secure random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<random-secret-at-least-32-chars>

# OpenAI key — backend only, NOT in frontend. Rotate any exposed key before use.
OPENAI_API_KEY=<your-openai-key>

# CORS origin for the Vite dev server
FRONTEND_URL=http://localhost:5173

